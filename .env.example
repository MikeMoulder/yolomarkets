# ──────────────────────────────────────────────────────────────────────────────
# Arc testnet
# ──────────────────────────────────────────────────────────────────────────────
# Public RPC (rate-limited):           https://rpc.testnet.arc.network
# dRPC public fallback:                https://arc-testnet.drpc.org
# Canteen-proxied RPC (token-gated):   arc-canteen rpc-url
ARC_TESTNET_RPC_URL=https://arc-testnet.drpc.org
ARC_TESTNET_RPC_URLS=https://arc-testnet.drpc.org,https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002

# USDC ERC-20 interface on Arc (6 decimals). Native gas USDC uses 18 decimals.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ──────────────────────────────────────────────────────────────────────────────
# Deployer / treasury (server-side EOA — NEVER commit)
# Fund with USDC from https://faucet.circle.com (Arc Testnet, USDC)
# ──────────────────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Fast market automation
FAST_MARKET_SEED_USDC=5
FAST_MARKET_POLL_SECONDS=30
FAST_MARKET_RESIDUAL_SWEEP_STATE_FILE=config/fast-market-residual-sweep.state.json
FAST_MARKET_RESIDUAL_SWEEP_INTERVAL_SECONDS=3600
FAST_MARKET_RESIDUAL_SWEEP_RECENT_LIMIT=96
FAST_MARKET_RESIDUAL_SWEEP_EMPTY_RECHECK_SECONDS=43200
FAST_MARKET_RESIDUAL_SWEEP_FULL_RESCAN_SECONDS=604800

# Fast market swarm automation (private-key config is generated locally)
FAST_SWARM_WALLETS_CONFIG=../config/fast-market-swarm.wallets.json
FAST_SWARM_STATE_FILE=../config/fast-market-swarm.state.json
FAST_SWARM_LIVE=0
FAST_SWARM_POLL_SECONDS=20
FAST_SWARM_PARTICIPATION_RATE=0.35
FAST_SWARM_MIN_BET_USDC=0.25
FAST_SWARM_MAX_BET_USDC=1.75
FAST_SWARM_RESERVE_USDC=5
FAST_SWARM_MAX_TX_PER_LOOP=8

# ──────────────────────────────────────────────────────────────────────────────
# Admin gate (web /admin route)
# ADMIN_COOKIE_SECRET signs the EIP-191 session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_ADDRESSES is a comma-separated list of EOAs allowed past the gate;
# the NEXT_PUBLIC_ mirror is read client-side to render the admin link.
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_COOKIE_SECRET=
ADMIN_ADDRESSES=
NEXT_PUBLIC_ADMIN_ADDRESSES=

# ──────────────────────────────────────────────────────────────────────────────
# Circle developer platform (for User-Controlled Wallets + Gas Station)
# Create at https://console.circle.com
# ──────────────────────────────────────────────────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=                 # 64 hex chars; see CIRCLE_SETUP.md
CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_APP_ID=            # mirror of CIRCLE_APP_ID for the Web SDK
CIRCLE_BLOCKCHAIN=ARC-TESTNET         # override if Console slug differs
CIRCLE_WALLET_SET_ID=                 # Developer Wallets → Wallet Sets
CIRCLE_GAS_STATION_POLICY=            # policy ID for gasless tx sponsorship

# ──────────────────────────────────────────────────────────────────────────────
# Agent LLMs
# ──────────────────────────────────────────────────────────────────────────────
# Preferred low-cost path: Google Gemini generateContent.
# Free users are forced onto GEMINI_FREE_MODEL; paid users use
# GEMINI_PRO_MODEL unless overridden in code/config. Rotate any key pasted
# into chat or logs before deploying.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_FREE_MODEL=gemini-3.1-flash-lite
GEMINI_PRO_MODEL=gemini-3-flash-preview
GEMINI_THINKING_LEVEL=low
GEMINI_TEMPERATURE=0.15
GEMINI_GOOGLE_SEARCH=0

# Paid market insight endpoint (/api/markets/:address/insight). OpenRouter is
# primary; Gemini is the fallback (leave AI_INSIGHT_PROVIDER blank).
# Set =openrouter to disable the Gemini fallback, =gemini for the legacy path.
AI_INSIGHT_PROVIDER=
GEMINI_INSIGHT_MODEL=gemini-3.1-flash-lite
GEMINI_INSIGHT_THINKING_LEVEL=low
GEMINI_INSIGHT_TEMPERATURE=0.15
GEMINI_INSIGHT_GOOGLE_SEARCH=0
# Same Gemini model as the Gemini path, routed through OpenRouter.
OPENROUTER_INSIGHT_MODEL=google/gemini-3.1-flash-lite
AI_INSIGHT_MAX_TOKENS=1200

# Primary path: OpenRouter. BRAIN_PROVIDER=openrouter makes policy.py pick the
# OPENROUTER_* tier models and routes brain.py through OpenRouter; Gemini stays
# as the fallback (BRAIN_FALLBACK=1). The OPENROUTER_*_MODEL slugs mirror the
# Gemini tiers (google/gemini-* = same models, billed via OpenRouter — no Google
# Console account needed). BRAIN_TEMPERATURE / OPENROUTER_REASONING_EFFORT mirror
# GEMINI_TEMPERATURE / GEMINI_THINKING_LEVEL onto the OpenRouter call.
BRAIN_PROVIDER=openrouter
BRAIN_FALLBACK=1
BRAIN_TEMPERATURE=0.15
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_STANDARD_MODEL=google/gemini-3-flash-preview
OPENROUTER_PRO_MODEL=google/gemini-3-flash-preview

# Orchestrator override. Leave blank to let tier policy choose the Gemini model.
BRAIN_MODEL=

# Web-search delegate. Sonar does live web search natively and returns
# citations; the orchestrator calls it as a tool when it decides news
# is relevant. Set BRAIN_WEB_TOOLS=0 to disable web_search entirely
# (cuts spend, OK for CI smoke runs).
BRAIN_SEARCH_MODEL=perplexity/sonar
BRAIN_WEB_TOOLS=1
BRAIN_MAX_TOKENS=1600

# Legacy single-shot path (used only as a fallback if brain.py won't load).
OPENROUTER_MODEL=perplexity/sonar
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
NEWS_API_KEY=

# Optional user notifications. Users paste their Telegram chat ID in
# /agent/settings; the runner sends messages through this bot.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# On-demand AI insight fee settings (web market page)
# 0.05 USDC is charged on-chain before insight generation.
AI_INSIGHT_FEE_RECIPIENT=
NEXT_PUBLIC_AI_INSIGHT_FEE_RECIPIENT=

# Phase 3: server-side session signer used by the runner. The public address
# is exposed via NEXT_PUBLIC_ so the wizard can authorise it on-chain.
# Generate with `cast wallet new`. Production must use a KMS.
AGENT_SESSION_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Phase A: Agentic economics
# ──────────────────────────────────────────────────────────────────────────────
# Platform treasury EOA — receives protocol fees (0.3% per trade) and
# subscription/profit-share payments. Use the deployer EOA for hackathon.
TREASURY_ADDRESS=

# x402 wrapper for live trading-agent reasoning requests.
# Every live brain request pays this USDC amount before calling the model,
# regardless of subscription tier. Receiver fallback order:
# AGENT_X402_PAY_TO_ADDRESS → X402_PAY_TO_ADDRESS → TREASURY_ADDRESS →
# AI_INSIGHT_FEE_RECIPIENT.
AGENT_X402_REASONING_FEE_USDC=0.01
AGENT_X402_PAY_TO_ADDRESS=
X402_NETWORK=arc-testnet
X402_ASSET=USDC

# Circle Developer-Controlled Wallets: used by the agent runner to sign and
# broadcast transactions on behalf of users without a session key.
NEXT_PUBLIC_AGENT_SESSION_ADDRESS=

# ──────────────────────────────────────────────────────────────────────────────
# Postgres
# Local dev (with docker-compose up -d db): the URL below.
# Production / hackathon: point at a hosted PG (Neon, Supabase, Railway PG).
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://yolo:yolo@localhost:5432/yolo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
REDIS_URL=

# Telegram market-listing pipeline (admin-only "List on YOLO" flow)
# Comma-separated Telegram chat/user IDs allowed to press the listing buttons.
# DM the bot /start to get your chat id. Callbacks from anyone else are refused.
TELEGRAM_ADMIN_CHAT_ID=
# Initial-liquidity preset buttons (whole USDC), comma-separated.
LISTING_SEED_OPTIONS=1,5,10,25
# Public site origin for "view market" links in Telegram messages.
NEXT_PUBLIC_SITE_URL=https://yolo.markets
