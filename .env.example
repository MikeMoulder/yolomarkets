# ──────────────────────────────────────────────────────────────────────────────
# Arc testnet
# ──────────────────────────────────────────────────────────────────────────────
# Public RPC (rate-limited):           https://rpc.testnet.arc.network
# Canteen-proxied RPC (token-gated):   arc-canteen rpc-url
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002

# USDC ERC-20 interface on Arc (6 decimals). Native gas USDC uses 18 decimals.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ──────────────────────────────────────────────────────────────────────────────
# Deployer / treasury (server-side EOA — NEVER commit)
# Fund with USDC from https://faucet.circle.com (Arc Testnet, USDC)
# ──────────────────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# ──────────────────────────────────────────────────────────────────────────────
# Admin gate (web /admin route)
# ADMIN_COOKIE_SECRET signs the EIP-191 session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_ADDRESSES is a comma-separated list of EOAs allowed past the gate;
# the NEXT_PUBLIC_ mirror is read client-side to render the admin link.
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_COOKIE_SECRET=
ADMIN_ADDRESSES=
NEXT_PUBLIC_ADMIN_ADDRESSES=

# ──────────────────────────────────────────────────────────────────────────────
# Circle developer platform (for User-Controlled Wallets + Gas Station)
# Create at https://console.circle.com
# ──────────────────────────────────────────────────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=                 # 64 hex chars; see CIRCLE_SETUP.md
CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_APP_ID=            # mirror of CIRCLE_APP_ID for the Web SDK
CIRCLE_BLOCKCHAIN=ARC-TESTNET         # override if Console slug differs
CIRCLE_GAS_STATION_POLICY=            # policy ID for gasless tx sponsorship

# ──────────────────────────────────────────────────────────────────────────────
# Agent
# ──────────────────────────────────────────────────────────────────────────────
# When ANTHROPIC_API_KEY is set, agent/brain.py kicks in — a multi-step
# Claude tool-use loop (web_search + web_fetch + fetch_polymarket_odds +
# compute_kelly) replaces the single-shot OpenRouter/Perplexity call.
# Leave both keys present to fall back to the legacy path if Claude errors.
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-sonnet-4-6       # override: claude-opus-4-7 for hard markets
BRAIN_WEB_TOOLS=1                   # set to 0 to disable Anthropic web tools

OPENROUTER_API_KEY=                 # legacy single-shot path
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=perplexity/sonar
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
NEWS_API_KEY=

# On-demand AI insight fee settings (web market page)
# 0.01 USDC is charged on-chain before insight generation.
AI_INSIGHT_FEE_RECIPIENT=
NEXT_PUBLIC_AI_INSIGHT_FEE_RECIPIENT=

# Phase 3: server-side session signer used by the runner. The public address
# is exposed via NEXT_PUBLIC_ so the wizard can authorise it on-chain.
# Generate with `cast wallet new`. Production must use a KMS.
AGENT_SESSION_PRIVATE_KEY=
NEXT_PUBLIC_AGENT_SESSION_ADDRESS=

# ──────────────────────────────────────────────────────────────────────────────
# Postgres
# Local dev (with docker-compose up -d db): the URL below.
# Production / hackathon: point at a hosted PG (Neon, Supabase, Railway PG).
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://yolo:yolo@localhost:5432/yolo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
REDIS_URL=
